PORT=4477
BASE_URL=http://localhost:4477

# Secret used to sign session cookies (registration/login). Set a long random
# string in production — anyone with this value can forge sessions.
SESSION_SECRET=dev-secret-change-me

# WayForPay merchant credentials. Defaults in server.js are WayForPay's
# public sandbox test merchant — fine for local testing, replace for real payments.
WFP_MERCHANT_ACCOUNT=test_merch_n1
WFP_MERCHANT_SECRET=flk3409refn54t54t5ff5
WFP_MERCHANT_DOMAIN=localhost

# Where WayForPay redirects the buyer / sends the server-to-server callback.
# Must be reachable from the internet for the callback to work outside sandboxes
# (e.g. via ngrok) — localhost only works for the return redirect, not the callback.
WFP_RETURN_URL=http://localhost:4477/order-success
WFP_SERVICE_URL=http://localhost:4477/api/wayforpay/callback

# Google Sign-In. Create credentials at https://console.cloud.google.com/apis/credentials
# -> "Create Credentials" -> "OAuth client ID" -> Application type "Web application".
# Add this exact Authorized redirect URI there: http://localhost:4477/auth/google/callback
# (update the host if BASE_URL differs). Leave blank to keep the Google button disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4477/auth/google/callback
